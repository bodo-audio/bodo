{
  "task": "Build a 4-pattern beat with the step sequencer and the sampler, and arrange it (the M2 exit criterion).",
  "calls": [
    { "id": "project.set_info", "params": { "title": "First Beat" } },
    { "id": "project.set_tempo", "params": { "bpm": 96 } },
    { "id": "pattern.rename", "params": { "name": "Intro" } },
    { "id": "pattern.set_steps", "params": { "channel": "Kick", "steps": "x... .... x... ...." } },
    { "id": "pattern.set_steps", "params": { "channel": "HiHat", "steps": "..x. ..x. ..x. ..x." } },
    { "id": "pattern.new", "params": { "name": "Verse" } },
    { "id": "pattern.set_steps", "params": { "channel": "Kick", "steps": "x... x... x... x..." } },
    { "id": "pattern.set_steps", "params": { "channel": "Clap", "steps": ".... x... .... x..." } },
    { "id": "pattern.set_steps", "params": { "channel": "HiHat", "steps": "x.x. x.x. x.x. x.x." } },
    { "id": "channel.add", "params": { "sample": "factory:Packs/Bodo Drums/808 Bass.wav", "name": "808" } },
    { "id": "pattern.set_steps", "params": { "channel": "808", "steps": "x... ..x. ..x. ...." } },
    { "id": "pattern.new", "params": { "name": "Fill" } },
    { "id": "pattern.set_steps", "params": { "channel": "Kick", "steps": "x... .... x.x. ...." } },
    { "id": "pattern.set_steps", "params": { "channel": "Snare", "steps": ".... x... x.x. xxxx" } },
    { "id": "pattern.new", "params": { "name": "Outro" } },
    { "id": "pattern.set_steps", "params": { "channel": "Kick", "steps": "x... .... .... ...." } },
    { "id": "pattern.set_steps", "params": { "channel": "808", "steps": "x... .... .... ...." } },
    { "id": "clip.place", "params": { "track": 1, "pattern": "Intro", "start": "1:1:0", "length": "2 bars" } },
    { "id": "clip.place", "params": { "track": 1, "pattern": "Verse", "start": "3:1:0", "length": "4 bars" } },
    { "id": "clip.place", "params": { "track": 1, "pattern": "Fill", "start": "7:1:0" } },
    { "id": "clip.place", "params": { "track": 1, "pattern": "Outro", "start": "8:1:0" } },
    { "id": "clip.place", "params": { "track": 2, "pattern": "Fill", "start": "6:1:0" } },
    { "id": "playlist.set_track_props", "params": { "track": 1, "name": "Drums" } },
    { "id": "channel.set_pan", "params": { "channel": "HiHat", "pan": 0.2 } },
    { "id": "mixer.set_volume", "params": { "insert": 2, "db": -3.0 } },
    { "id": "transport.set_mode", "params": { "mode": "song" } }
  ]
}
